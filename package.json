{
  "name": "lodgify-listener",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "npm run build --silent && node --env-file-if-exists=.env --watch dist/index.js",
    "smoke": "npm run build --silent && node dist/smoke.js",
    "release": "release-it",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "release-it": "^21.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
