{
  "name": "lodgify-listener",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "npm run build --silent && node --env-file-if-exists=.env --watch dist/index.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "smoke": "npm run build --silent && node dist/smoke.js",
    "release": "release-it",
    "prepare": "husky",
    "test": "npm run build --silent && node --test dist/autoreply/state.test.js dist/autoreply/processing.test.js dist/autoreply/delivery.test.js dist/autoreply/adapters.test.js dist/autoreply/lodgify-webhook-auth.test.js dist/autoreply/http.test.js",
    "test:worker": "npm run build --silent && wrangler deploy --dry-run --outdir .worker-test && node --test dist/autoreply/worker.test.js"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "miniflare": "^5.20260916.0-alpha",
    "release-it": "^21.0.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true
  }
}
