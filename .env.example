# Variabili del server Node precedente (`npm run dev`), caricate da `.env`.
# TYPESAFE_API_KEY: chiave API del servizio TypeSafe.
TYPESAFE_API_KEY=

# Nomi condivisi da Node e Worker; Wrangler richiede i valori in `.dev.vars`.
LODGIFY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Percorsi opzionali dei contesti usati dal server Node.
PROPERTY_CONTEXT_PATH=data/property-context.md
HOST_FAQ_CONTEXT_PATH=data/host-faq-context.md
PORT=3000

# Variabili del Cloudflare Worker. Wrangler NON legge queste da `.env`:
# copia `.dev.vars.example` in `.dev.vars` per `npm run dev:worker`.
# Le variabili seguenti sono elencate qui come inventario completo del progetto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
WEBHOOK_TOKEN=
# Secret Lodgify della subscription, usato per verificare l'header ms-signature.
LODGIFY_WEBHOOK_SECRET=
ADMIN_TOKEN=
# JSON con mappa property_id -> testo completo del manuale.
PROPERTY_CONTEXTS_JSON='{"12345":"Inserisci qui il manuale dell'alloggio."}'
# false invia anteprime su Telegram; true abilita l'invio agli ospiti.
AUTO_REPLY_ENABLED=false
